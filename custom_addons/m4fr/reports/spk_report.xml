<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template report awal untuk Surat Perintah Kerja (SPK) -->
    <record id="action_report_spk" model="ir.actions.report">
        <field name="name">Surat Perintah Kerja (SPK)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">m4fr.report_spk_template</field>
        <field name="report_file">m4fr.report_spk_template</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_spk_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <h2 class="text-center">SURAT PERINTAH KERJA (SPK)</h2>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Nomor Pesanan:</strong> <span t-field="doc.name"/><br/>
                                <strong>Pelanggan:</strong> <span t-field="doc.partner_id.name"/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Tenggat Waktu:</strong> <span t-field="doc.deadline_at"/><br/>
                                <strong>Status Produksi:</strong> <span t-field="doc.production_status"/><br/>
                            </div>
                        </div>

                        <table class="table table-sm o_main_table mt16">
                            <thead>
                                <tr>
                                    <th>Produk</th>
                                    <th class="text-right">Jumlah</th>
                                    <th>Spesifikasi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <tr>
                                        <td><span t-field="line.product_id.name"/></td>
                                        <td class="text-right"><span t-field="line.product_uom_qty"/></td>
                                        <td><span t-field="line.name"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
