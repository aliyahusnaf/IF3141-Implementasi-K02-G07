<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="action_report_invoice" model="ir.actions.report">
		<field name="name">Invoice M4FR</field>
		<field name="model">m4fr.invoice</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">m4fr.report_invoice_template</field>
		<field name="report_file">m4fr.report_invoice_template</field>
		<field name="binding_model_id" ref="model_m4fr_invoice"/>
		<field name="binding_type">report</field>
	</record>

	<template id="report_invoice_template">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="doc">
				<t t-call="web.external_layout">
					<div class="page">
						<h2 class="text-center">INVOICE M4FR</h2>

						<div class="row mt16 mb16">
							<div class="col-6">
								<strong>Invoice:</strong> <span t-field="doc.name"/><br/>
								<strong>Sales Order:</strong> <span t-field="doc.order_id.name"/><br/>
								<strong>Issue Date:</strong> <span t-field="doc.issue_date"/><br/>
							</div>
							<div class="col-6">
								<strong>Status:</strong> <span t-field="doc.invoice_status"/><br/>
								<strong>Due Date:</strong> <span t-field="doc.due_date"/><br/>
								<strong>Sent At:</strong> <span t-field="doc.sent_at"/><br/>
							</div>
						</div>

						<table class="table table-sm o_main_table mt16">
							<thead>
								<tr>
									<th>Description</th>
									<th class="text-right">Amount</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Order Total Snapshot</td>
									<td class="text-right"><span t-field="doc.total_snapshot"/></td>
								</tr>
								<tr>
									<td>Demand Type</td>
									<td class="text-right"><span t-field="doc.demand_type"/></td>
								</tr>
								<tr>
									<td>Demand Value</td>
									<td class="text-right"><span t-field="doc.demand_value"/></td>
								</tr>
								<tr>
									<td>Amount Due</td>
									<td class="text-right"><span t-field="doc.amount_due"/></td>
								</tr>
							</tbody>
						</table>

						<h4 class="mt32">Payments</h4>
						<table class="table table-sm">
							<thead>
								<tr>
									<th>Date</th>
									<th>Method</th>
									<th>Receipt</th>
									<th class="text-right">Amount</th>
								</tr>
							</thead>
							<tbody>
								<t t-foreach="doc.payment_ids" t-as="payment">
									<tr>
										<td><span t-field="payment.payment_date"/></td>
										<td><span t-field="payment.payment_method"/></td>
										<td><span t-field="payment.receipt_url"/></td>
										<td class="text-right"><span t-field="payment.amount"/></td>
									</tr>
								</t>
							</tbody>
						</table>
					</div>
				</t>
			</t>
		</t>
	</template>
</odoo>