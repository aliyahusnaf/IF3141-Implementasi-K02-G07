        </record>
        <record id="demo_user_kepala" model="res.users">
            <field name="name">Kepala Produksi Demo</field>
            <field name="login">kepala@m4fr.test</field>
            <field name="password">Password123</field>
            <field name="role">jb05</field>
        </record>

    </data>
</odoo>
