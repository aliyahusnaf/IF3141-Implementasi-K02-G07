<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_m4fr_root" 
              name="M4FR" 
              web_icon="m4fr,static/description/icon_penjualan.png"
              sequence="10"/>

    <!-- Sembunyikan menu Sales asli bawaan Odoo dengan memberi grup yang tidak dimiliki siapapun -->
    <record id="sale.sale_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>

    <!-- Menu Penjualan -->
    <menuitem id="menu_m4fr_penjualan"
              name="Penjualan"
              parent="menu_m4fr_root"
              sequence="10"
              groups="m4fr.group_m4fr_admin,m4fr.group_m4fr_direktur,m4fr.group_m4fr_manajer_keuangan"/>

    <menuitem id="menu_m4fr_sale_order"
              name="Pesanan"
              parent="menu_m4fr_penjualan"
              action="action_m4fr_all_sale_orders"
              sequence="10"/>

    <menuitem id="menu_m4fr_client"
              name="Pelanggan"
              parent="menu_m4fr_penjualan"
              action="action_m4fr_custom_clients"
              sequence="20"/>

    <!-- Menu Produksi -->
    <menuitem id="menu_m4fr_produksi"
              name="Produksi"
              parent="menu_m4fr_root"
              sequence="20"
              groups="m4fr.group_m4fr_admin,m4fr.group_m4fr_direktur,m4fr.group_m4fr_manajer_produksi,m4fr.group_m4fr_kepala_produksi"/>

    <menuitem id="menu_m4fr_production_active"
              name="Daftar Pesanan Aktif"
              parent="menu_m4fr_produksi"
              action="action_active_orders_manajer_produksi"
              groups="m4fr.group_m4fr_manajer_produksi,m4fr.group_m4fr_direktur"
              sequence="10"/>

    <menuitem id="menu_m4fr_production_status"
              name="Status Produksi"
              parent="menu_m4fr_produksi"
              action="action_production_status_update"
              groups="m4fr.group_m4fr_kepala_produksi,m4fr.group_m4fr_admin,m4fr.group_m4fr_direktur"
              sequence="20"/>
</odoo>
