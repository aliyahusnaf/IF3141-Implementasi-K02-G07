<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_m4fr_custom_client_tree" model="ir.ui.view">
        <field name="name">m4fr.client.tree</field>
        <field name="model">m4fr.client</field>
        <field name="arch" type="xml">
            <tree string="Pelanggan" editable="bottom">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>
            </tree>
        </field>
    </record>

    <record id="view_m4fr_custom_client_form" model="ir.ui.view">
        <field name="name">m4fr.client.form</field>
        <field name="model">m4fr.client</field>
        <field name="arch" type="xml">
            <form string="Pelanggan">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Contoh: Budi Santoso"/></h1>
                    </div>
                    <group>
                        <group string="Kontak">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group string="Lokasi">
                            <field name="address" placeholder="Alamat lengkap..."/>
                            <field name="city"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_m4fr_custom_clients" model="ir.actions.act_window">
        <field name="name">Pelanggan</field>
        <field name="res_model">m4fr.client</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Buat pelanggan pertama Anda!</p>
        </field>
    </record>
</odoo>
