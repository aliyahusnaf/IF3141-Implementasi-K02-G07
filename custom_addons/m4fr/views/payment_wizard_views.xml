<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_m4fr_invoice_payment_wizard_form" model="ir.ui.view">
		<field name="name">m4fr.invoice.payment.wizard.form</field>
		<field name="model">m4fr.invoice.payment.wizard</field>
		<field name="arch" type="xml">
			<form string="Validasi Pembayaran">
				<group>
					<field name="invoice_id" readonly="1"/>
					<field name="currency_id" invisible="1"/>
					<field name="amount_due" readonly="1" widget="monetary"/>
					<field name="amount" widget="monetary"/>
					<field name="payment_date"/>
					<field name="payment_method"/>
					<field name="receipt_url" placeholder="https://..."/>
				</group>
				<footer>
					<button name="action_confirm" type="object" string="Validasi" class="btn-primary"/>
					<button string="Batal" special="cancel" class="btn-secondary"/>
				</footer>
			</form>
		</field>
	</record>
</odoo>