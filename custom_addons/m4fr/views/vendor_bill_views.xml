<odoo>
    <record id="view_m4fr_vendor_bill_form" model="ir.ui.view">
        <field name="name">m4fr.vendor.bill.form</field>
        <field name="model">m4fr.vendor.bill</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="validateBill" string="Konfirmasi" type="object" class="oe_highlight" invisible="payment_status != 'draft'"/>
                    <button name="processPayment" string="Bayar &amp; Terima Barang" type="object" class="oe_highlight" invisible="payment_status != 'confirmed'"/>
                    <field name="payment_status" widget="statusbar" statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="bill_date"/>
                        </group>
                        <group>
                            <field name="bill_type"/>
                            <field name="vendor_bill_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Item Bahan Baku">
                            <field name="bill_item_ids">
                                <tree editable="bottom">
                                    <field name="raw_material_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Biaya Tambahan (Adjustments)">
                            <field name="adjustment_ids">
                                <tree editable="bottom">
                                    <field name="adjustment_name"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="grand_total" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_m4fr_vendor_bill" model="ir.actions.act_window">
        <field name="name">Tagihan Vendor</field>
        <field name="res_model">m4fr.vendor.bill</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_m4fr_vendor_bill" name="Tagihan Vendor" parent="menu_m4fr_inventory_root" 
              action="action_m4fr_vendor_bill" sequence="20"/>
</odoo>