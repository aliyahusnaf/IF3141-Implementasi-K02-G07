<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_update_production_status_wizard_form" model="ir.ui.view">
        <field name="name">m4fr.update.production.status.wizard.form</field>
        <field name="model">m4fr.update.production.status.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="current_status" readonly="1" string="Status Saat Ini"/>
                    <field name="new_status" readonly="1" string="Tahap Berikutnya"/>
                    <field name="note" placeholder="Catatan opsional tentang kondisi produksi..."/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Konfirmasi"
                            type="object"
                            class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
