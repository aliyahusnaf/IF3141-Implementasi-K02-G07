<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence untuk Sales Order M4FR -->
        <record id="seq_m4fr_sale_order" model="ir.sequence">
            <field name="name">M4FR Sales Order</field>
            <field name="code">m4fr.sale.order</field>
            <field name="prefix">M4FR/SO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_m4fr_raw_material" model="ir.sequence">
            <field name="name">Raw Material Sequence</field>
            <field name="code">m4fr.raw.material</field>
            <field name="prefix">RM</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_m4fr_material_movement" model="ir.sequence">
            <field name="name">Material Movement Sequence</field>
            <field name="code">m4fr.material.movement</field>
            <field name="prefix">MOV</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_m4fr_vendor" model="ir.sequence">
            <field name="name">Vendor Sequence</field>
            <field name="code">m4fr.vendor</field>
            <field name="prefix">VND</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_m4fr_vendor_bill" model="ir.sequence">
            <field name="name">Vendor Bill Sequence</field>
            <field name="code">m4fr.vendor.bill</field>
            <field name="prefix">BILL/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
